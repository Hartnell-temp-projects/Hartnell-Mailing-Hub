# Secrets (DUO_CLIENT_SECRET, BOX_CLIENT_SECRET) are read from AWS Secrets Manager
# when SECRETS_MANAGER_PREFIX is set, e.g. hartnell-mailer/prod/DUO_CLIENT_SECRET.
# Leave it unset for local dev and put the secrets in .env instead.
# SECRETS_MANAGER_PREFIX=hartnell-mailer/prod

# Key for the encrypted session cookies: base64-encoded 32 bytes.
# Generate with: openssl rand -base64 32
# Read from Secrets Manager when SECRETS_MANAGER_PREFIX is set (hartnell-mailer/prod/SESSION_SECRET).
SESSION_SECRET=your-base64-32-byte-key # local dev only

# AWS configuration
# In deployed environments, use an IAM role (instance/task/Lambda role).
# Do not set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY there.
AWS_REGION=us-west-2
SES_FROM_ADDRESS=verified-sender@example.edu
SES_TEMPLATE_NAME=HartnellMailerPersonalized
# Cross-account role in the SES account, assumed via STS for every send.
SES_ROLE_ARN=arn:aws:iam::123456789012:role/your-ses-sender-role
REDSHIFT_ROLE_ARN=arn:aws:iam::123456789012:role/your-redshift-role
REDSHIFT_CLUSTER=your-cluster
REDSHIFT_DB=your-db
REDSHIFT_DB_USER=your-db-user

# Duo Generic OIDC configuration
DUO_ISSUER=https://your-duo-issuer.example/oidc/your-app-id
DUO_CLIENT_ID=your-duo-client-id
DUO_CLIENT_SECRET=your-duo-client-secret # local dev only
DUO_REDIRECT_URI=http://localhost:3000/api/auth/callback
DUO_SCOPE=openid profile email

# Box storage
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret # local dev only
BOX_ENTERPRISE_ID=your-box-enterprise-id
BOX_ROOT_FOLDER_ID=your-box-root-folder-id
